# Copy to .env and fill in. Never commit the real .env.
DEPLOY_ENV=local
GRAFANA_ADMIN_PASSWORD=change-me

# --- TraceWhisper analyzer / agent ---
# Anthropic credentials (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=
TRACEWHISPER_MODEL=claude-opus-5-5
TRACEWHISPER_EFFORT=high
TRACEWHISPER_MAX_TURNS=12
JAEGER_URL=http://localhost:16686
PROMETHEUS_URL=http://localhost:9090
